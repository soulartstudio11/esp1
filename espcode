unsigned long lastPublish = 0;
const unsigned long PUBLISH_INTERVAL = 2000;

// ========================================
// CONNECT TO WIFI
// ========================================
void connectWiFi() {
  Serial.print("Connecting to Wi-Fi");

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("Wi-Fi connected!");
  Serial.print("ESP32 IP address: ");
  Serial.println(WiFi.localIP());
}

// ========================================
// CONNECT TO EMQX MQTT
// ========================================
void connectMQTT() {
  while (!mqttClient.connected()) {
    Serial.print("Connecting to EMQX...");

    String clientId =
      "LightGuard-ESP32-" +
      String((uint32_t)ESP.getEfuseMac(), HEX);

    if (mqttClient.connect(
          clientId.c_str(),
          MQTT_USERNAME,
          MQTT_PASSWORD)) {

      Serial.println(" connected!");
    } else {
      Serial.print(" failed, MQTT state = ");
      Serial.println(mqttClient.state());
      Serial.println("Retrying in 3 seconds...");
      delay(3000);
    }
  }
}

// ========================================
// READ AND PUBLISH LDR STATUS
// ========================================
void publishLightStatus() {
  int sensorValue = digitalRead(LDR_PIN);

  bool isDark;

  if (DARK_WHEN_LOW) {
    isDark = (sensorValue == LOW);
  } else {
    isDark = (sensorValue == HIGH);
  }

  const char* status = isDark ? "DARK" : "BRIGHT";

  if (mqttClient.publish(MQTT_TOPIC, status, true)) {
    Serial.print("LDR digital value: ");
    Serial.print(sensorValue);

    Serial.print(" | Light status: ");
    Serial.println(status);
  } else {
    Serial.println("MQTT publish failed");
  }
}

// ========================================
// SETUP
// ========================================
void setup() {
  Serial.begin(115200);
  delay(1000);

  pinMode(LDR_PIN, INPUT);

  // Validate certificate configuration
  if (String(ROOT_CA).indexOf("PASTE_THE_COMPLETE") >= 0) {
    Serial.println("ERROR: Add the real EMQX root CA certificate.");
    Serial.println("TLS connection has not been started.");
    while (true) {
      delay(1000);
    }
  }

  secureClient.setCACert(ROOT_CA);
  mqttClient.setServer(MQTT_SERVER, MQTT_PORT);
  mqttClient.setKeepAlive(60);
  mqttClient.setSocketTimeout(10);

  connectWiFi();
  connectMQTT();

  Serial.println("LightGuard is ready!");
}

// ========================================
// MAIN LOOP
// ========================================
void loop() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("Wi-Fi disconnected. Reconnecting...");
    WiFi.disconnect();
    connectWiFi();
  }

  if (!mqttClient.connected()) {
    connectMQTT();
  }

  mqttClient.loop();

  unsigned long now = millis();

  if (now - lastPublish >= PUBLISH_INTERVAL) {
    lastPublish = now;
    publishLightStatus();
  }
}
